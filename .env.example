# Teaching Agent — Backend Environment Variables
# Copy this file to .env and fill in real values after CDK deploy.
# Never commit .env to version control.

# ── Cognito (from CDK stack outputs) ─────────────────────────────────────────
COGNITO_REGION=eu-west-2
COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Full Cognito Hosted UI domain, e.g.:
COGNITO_DOMAIN=https://teaching-agent-auth.auth.eu-west-2.amazoncognito.com

# ── Cookie security ────────────────────────────────────────────────────────────
# Set to "false" for local HTTP dev only; must be "true" in production
COOKIE_SECURE=true

# ── Bedrock ───────────────────────────────────────────────────────────────────
BEDROCK_REGION=eu-west-2
BEDROCK_GUARDRAIL_ID=xxxxxxxxxxxxxxxxxxxxxxxx
BEDROCK_GUARDRAIL_VERSION=DRAFT
BEDROCK_KNOWLEDGE_BASE_ID=XXXXXXXXXX

# ── DynamoDB ──────────────────────────────────────────────────────────────────
DYNAMODB_TABLE_NAME=teaching-agent-tracking-dev

# ── API ───────────────────────────────────────────────────────────────────────
# CORS origin for the frontend (overrides the localhost default)
FRONTEND_ORIGIN=http://localhost:5173
