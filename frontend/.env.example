# Teaching Agent — Frontend Environment Variables (Vite)
# Copy to frontend/.env.local and fill in after CDK deploy.
# VITE_* variables are inlined at build time — do not put secrets here.

# Backend API URL (leave empty for Vite proxy in dev)
VITE_API_URL=http://localhost:8000

# Cognito Hosted UI domain (from CDK output "HostedUIDomain")
VITE_COGNITO_DOMAIN=https://teaching-agent-auth.auth.eu-west-2.amazoncognito.com

# Cognito App Client ID (from CDK output "AppClientId")
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Redirect URI after login (must match CDK app client callback URLs)
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
